{
  "name": "nahflix",
  "account_id": "8fba540fe71f4b89e1a5c4968afaa633",
  "main": "nahflix-site.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SOURCE_HOST_URL": "https://lampa-source-host.ocr-gemini-proxy.workers.dev",
    "PROFILE_STORAGE_BACKEND": "blob"
  },
  "services": [
    { "binding": "SOURCE_HOST", "service": "lampa-source-host" },
    { "binding": "ROOMS", "service": "lampa-rooms" }
  ],
  "durable_objects": { "bindings": [{ "name": "PROFILES", "class_name": "ProfileStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProfileStore"] }]
}
